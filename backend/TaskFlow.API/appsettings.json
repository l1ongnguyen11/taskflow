{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=taskflow;Username=postgres;Password=YOUR_POSTGRES_PASSWORD"
  },

  "Jwt": {
    "Issuer": "TaskFlow",
    "Audience": "TaskFlowClient",
    "SecretKey": "YOUR_LOCAL_DEV_SECRET_KEY_CHANGE_IN_ENV_VARS_FOR_PRODUCTION",
    "ExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:3000",
      "http://127.0.0.1:5173"
    ]
  },

  "FileStorage": {
    "MaxSizeBytes": 10485760,
    "AllowedExtensions": [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".png", ".jpg", ".jpeg", ".gif", ".zip", ".txt"],
    "AllowedMimeTypes": []
  },

  "SmtpSettings": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "SenderEmail": "no-reply@taskflow.local",
    "SenderName": "TaskFlow System",
    "Username": "",
    "Password": "",
    "AppUrl": "http://localhost:5173"
  }
}